# Darkhold configuration.
#
# Precedence, highest first:
#   command-line argument  →  environment variable  →  this file  →  default
#
# Copy to `darkhold.toml` and edit. Every key below is optional; the values
# shown are the defaults outside production. Unknown keys are a startup error
# rather than a silently ignored line, so a typo is caught immediately.
#
# Environment variables use the DARKHOLD_ prefix, e.g.
#   DARKHOLD_PORT=9000
#   DARKHOLD_DATABASE_URL=postgres://user:pass@host/darkhold

# development | test | production
environment = "development"

[site]
# Shown in the interface, feeds and notification emails.
name = "Darkhold"
# The instance's one-line identity: the document title, the front page's
# eyebrow, and /api/v1/meta. It is public, because the instance's identity is
# public (spec §12.1, D-8) — a hidden identity is a private preference.
tagline = "The dark side of fanfiction"
# Public address, used for links, feeds and cookie scoping. Must be https in
# production.
base_url = "http://localhost:8080"
# Shown on legal pages and in feed metadata.
# contact_email = "operator@example.com"

[server]
# Bind address. Keep this on loopback and terminate TLS in a reverse proxy.
bind = "127.0.0.1"
port = 8080
# Largest accepted request body. Uploads and imports need this raised when they
# arrive; 2 MiB is generous for JSON.
max_body_bytes = 2097152
# Per-request ceiling, so one slow handler cannot hold a connection slot.
request_timeout_secs = 30
# Cross-origin origins. Empty means same-origin only, which is the default and
# the recommended setting. "*" is refused in production.
# cors_origins = ["https://darkhold.example"]

[database]
# SQLite (default): a single file, no server to run.
url = "sqlite://./data/darkhold.sqlite?mode=rwc"
# PostgreSQL: uncomment instead of the SQLite URL.
# url = "postgres://darkhold:secret@localhost/darkhold"
max_connections = 5
acquire_timeout_secs = 10

[storage]
# Root for uploads, exports and cached media. Must be an absolute path in
# production.
root = "./data"

[security]
# Secure cookies require HTTPS. Defaults to true in production and false
# otherwise; setting it false in production is a startup error.
# cookie_secure = true
# How long a session survives without re-authentication.
session_ttl_days = 30
# Required for state-changing cookie-authenticated requests. Turning this off
# in production is a startup error.
csrf_required = true

[logging]
# Tracing filter directives.
filter = "info,darkhold_app=debug,darkhold_db=debug"
# pretty | json
format = "pretty"

[assets]
# Development only: serve the frontend from disk so a `vite build --watch` loop
# does not need a Rust rebuild. Production refuses this and serves the bundle
# compiled into the binary.
# dir = "./frontend/dist"

[imports]
# Whether a path a source's `robots.txt` forbids is refused.
#
# True by default, and the default is the recommended setting: `robots.txt` is
# how a host says which of its pages it wants crawled, and reading the file and
# then ignoring it is what the file exists to prevent. Some archives, though,
# forbid the whole site while serving a public reading view, and an operator of a
# personal instance may judge that importing a work for their own reading is not
# what the rule was aimed at. That judgement is yours to make; it is not made for
# you here.
#
# Switching this off does **not** switch off pacing. The same file's
# `Crawl-delay`, and the one-second floor beneath it, are still enforced exactly
# as before — a permission question and a load question arrive in one file, and
# answering one differently says nothing about the other. Every path that is read
# anyway is counted, and the first one per host is logged at `warn` naming the
# host and this setting, so an instance that switches it off can say what it cost.
#
# It is also unrelated to access control: `robots.txt` is a crawling convention,
# not authentication. Nothing here defeats a login, an age gate, or a challenge.
# honour_robots = true

# The robots policy itself, as a named posture: `strict`, `permissive`, or `off`.
# `honour_robots` above is the compatibility key for older files — `false`
# selects `permissive` — and is a fallback rather than a default, so naming a
# posture here is the way to say what you mean. Unset means the operator named no
# posture, and `honour_robots` then decides.
# robots_posture = "strict"

# Per-adapter overrides, keyed by the adapter's `key()` (the same string the
# source catalogue and `sources.key` use) rather than by host, because hosts are
# not unique and a name you retype is a name you can mistype.
# [imports.robots_posture_overrides.ao3]
# robots_posture = "permissive"

# --- What a reader of the archive may see ----------------------------------
#
# The baseline. Individual works are widened and narrowed from here, by an
# operator or — see `[retention_governance]` below — by the readers themselves.
# [retention]
# default_body_audience = "full"
# body_request_min_trust = 2

# The trust level a reader needs to ask this instance to fetch and keep an
# external body for them personally (§11.15b). Default 2, floor 0. This gates
# the REQUEST; no read path consults it, so a copy is not a readers'-tier.

# --- Who gets a say in storage, and whether a vote decides ----------------
#
# A reader's trust level gates the roadmap, not their standing in the
# community: participation is a thing you earn, and a vote never grants the
# proposer anything personal.
# [roadmap]
# min_trust = 1

# Whether body-retention changes are decided by ballot or by operator, and how
# many people it takes.
#
# `binding_mode = false` (the default) is ADVISORY: readers reach a decision and
# the record says what they decided, but an operator applies it. Use this on an
# instance you would rather not have surprised.
#
# `binding_mode = true` is BINDING: a passed ballot commits on its own once its
# window shuts. Use it where "the readers decided" is a thing you want to be able
# to say truthfully.
#
# `widen_quorum` applies only to a change that makes the archive KEEP MORE — a
# change that stores less is judged at the ordinary bar of three, because a
# proposal to delete is not the thing that costs anything. A value below three
# is refused rather than honoured: a bar under three is one person's second tap.
# A value above your reader count is honoured, and means this instance does not
# change storage policy by vote.
#
# `proposal_cooling_days` is how long a ballot stays open, and it is recorded per
# proposal when the proposal is opened — so changing it here does not move the
# deadline of a ballot people are already voting in.
# [retention_governance]
# proposal_min_trust = 1
# widen_quorum = 3
# proposal_cooling_days = 7
# binding_mode = false

# A FlareSolverr-compatible service this instance may drive, e.g. Byparr or
# obscura-solverr on loopback. Needed only for a source whose adapter declares it
# answers a bot challenge a plain request cannot pass; without one, such a source
# is refused before an import is queued, naming this setting.
# solver_url = "http://127.0.0.1:8191"

# Whether a page the source will not serve may be read from the Internet Archive
# instead. Off by default: it is the one fallback that reads a *different*
# resource, and for a work the source has deleted it can put a work back in front
# of readers that its author withdrew.
# archive_fallback = false

# Instance identity and accessibility (spec §0.4.6, §0.4.7).
[instance]
# Preset name: open_library, curated_boutique, admin_garden, genre_haven,
# experimental_lab, custom. (spec §0.6)
# preset = "curated_boutique"

# Who may reach this instance without signing in:
#   public        — anyone may browse. Writing always needs an account.
#   walled_garden — browsing needs an account. The landing page and /api/v1/meta
#                   stay open, because a reader who cannot see the sign-in
#                   link cannot use it.
#   private       — the operator only. For maintenance and isolated development.
#
# An unrecognised value stops startup rather than falling back to `public`: a
# misspelling that silently opened the instance would be found by a stranger.
# mode = "public"

# Theme mode and gravity settings (spec §0.4.6).
#
# `mode` selects the instance's discovery posture:
#   `generic`   — no topic gravity; public topics still earn gamification bonuses
#                 but do not rank works higher for anyone who hasn't opted in.
#   `thematic` — declared public topics provide a bounded upward nudge in
#                 discovery (the default).
#   `adaptive` — the instance's theme drifts toward what its long-term
#                 contributors actually read and write, bounded by
#                 `adaptive_max_drift_bp`.
#
# `allow_user_opt_out` decides whether the §16.5 dial can reach zero for theme
# influence. When false, `theme_dial_floor_bp` is the dial's lower bound.
#
# `influence_sources` orders who shapes instance taste, strongest first:
#   `operator_topics` — the declared public topics' tag vectors.
#   `admin_taste`     — the §16.2 administrator taste profile.
#   `long_term_users` — aggregate of accounts whose tenure ≥ `min_tenure_days`
#                       (default 90) and contribution count ≥ `min_contributions`
#                       (default 5). Uses §16.16.1 contribution events — not logins.
#                       The §16.15 cohort floor (≥ 5 distinct accounts) applies.
#
# mode = "thematic"
# allow_user_opt_out = true
# theme_dial_floor_bp = 1000   # 10% floor when opt-out is locked
# adaptive_max_drift_bp = 0    # no drift in thematic mode
#
# influence_sources = [
#   { kind = "operator_topics" },
#   { kind = "admin_taste" },
#   { kind = "long_term_users", min_tenure_days = 90, min_contributions = 5 },
# ]
#
# boost_tags = ["adventure", "fantasy"]
# suppress_tags = ["explicit"]
# tag_gravity_bp = { "space opera" = 2500 }

[tts]
# Which engine narrates a work when an author asks for a machine recording.
#
# `piper` (the default) is local: the text never leaves this host, which is the
# point of the default. `silent` produces a well-formed but silent track and
# exists so an operator can exercise the whole pipeline — chunking, storage, the
# draft gate — on a host with no synthesizer at all. Cloud adapters (ElevenLabs,
# AWS Polly) will be added behind the same setting, with their own keys and the
# spend cap below.
#
# An engine that is named but not installed does not stop the instance: the
# narration request is refused with the sentence `darkhold doctor` prints, and
# everything else keeps working.
# engine = "piper"

# Path to the `piper` binary. Unset means "whatever `piper` is on PATH"; a path
# set here wins over discovery, because an operator who names a binary means
# that binary.
# piper_path = "/opt/piper/piper"

# Path to the Piper voice model (`.onnx`). Required by Piper: the model is a
# file, and Piper's model directory is a property of an installation, so a bare
# voice name is not guessed at.
# piper_voice_model = "/opt/piper/en_US-lessac-medium.onnx"

# The voice a narration uses when the request does not name one. A name is
# recorded on the edition as the voice, and only a path resolves to a model.
# default_voice = "en_US-lessac-medium"

# Per-instance monthly ceiling, in cents, for engines that charge per request.
# Only a cloud adapter can spend, so this is unset by default — but it is
# configuration before there is an adapter that bills, not a number invented in
# a route later.
# monthly_spend_cap_cents = 500

[forum]
# How discussion happens around a work (spec §35.0).
#
# `comments_only` (the default) keeps the classic comment surface. Setting
# `thread_only` applies to **new** works: the work page shows a typed-vote
# reaction bar and a "Discuss" link, and all text discussion lives in a linked
# forum topic. The default is never applied to existing works retroactively.
# `both` offers both surfaces and splits conversation — use it deliberately.
# work_discussion_default = "comments_only"

# Typed votes (spec §35.2). The vote budget is a rolling 24-hour allowance,
# keyed by trust level; unused votes do not roll over. The values below are the
# spec's defaults. A trust level below the lowest rung gets that rung's
# allowance, so a new account can still vote.
# vote_budget = { "1" = 10, "3" = 30, "5" = 60 }

# Meta-moderation (spec §35.2): TL4+ stewards flag votes fair or unfair. These
# are the points a steward may spend per rolling 24 hours, and the number of
# verdicts a caster needs before their vote *weight* (never their voice) starts
# to decay. `min_vote_weight_bp` is the floor, in basis points: 1000 is full
# weight, so 100 means a fully-decayed caster's votes count one tenth.
# meta_mod_points = 20
# meta_mod_min_verdicts = 3
# min_vote_weight_bp = 100

# Karma decays while its holder is inactive (spec §35.2), at this percentage
# per 30-day month. Karma is a display signal only: it never gates trust,
# moderation, search ranking or credits.
# karma_decay_percent = 5

[dev]
# Whether `darkhold seed` may write development fixtures. Defaults to true
# outside production and false in it; enabling it in production is a startup
# error.
seed_enabled = true

# --- Revisions, jobs, library (spec §38) -----------------------------------
[revisions]
# How long a cached source revision lives, in seconds. Default 604800 (7 days).
# ttl_secs = 604800

[jobs]
# How long terminal jobs are kept, in days. Default 30.
# terminal_retention_days = 30

[library]
# How long an update-check record is kept, in days. Default 90.
# update_check_retention_days = 90
# How many items one library update job checks. Default 50.
# check_batch = 50

[bulk_export]
# How many works a bulk export may bundle. Default 50.
# max_items = 50
# How many bytes a bulk export may total. Default 1073741824 (1 GiB).
# max_bytes = 1073741824

[administration]
# Account ID of the operator (may access /admin).
# operator_account_id = 1

# Webhook delivery settings (spec §38).
# webhook_timeout_secs = 10
# webhook_max_attempts = 5
# webhook_base_delay_ms = 500

# ---------------------------------------------------------------------------
# Calibrated decision models (spec §11.14, amendment
# docs/spec-amendments/calibrated-decision-models.md)
#
# OFF by default. With provider = "deterministic" nothing here is consulted and
# the instance behaves exactly as it did before the feature existed.
#
# With provider = "calibrated" a decision model is asked whether a candidate is
# really a work, and its answer can NARROW an acceptance to a hold. It cannot
# reject and it cannot accept: §11.14's rejection is structural (an empty
# author is arithmetic), and its acceptance rests on evidence a text model never
# sees. The worst a bad model can do is send a work to a human.
#
# A machine learning model is doing the classification. Start with the audit
# trail (GET /api/v1/decisions/audit, operator-only) and leave the threshold
# where it is.
# ---------------------------------------------------------------------------
[decisions]
provider = "deterministic"
# Where the model is served. Unsloth Studio's default; a remote host is the
# operator's own decision.
base_url = "http://127.0.0.1:8888"
# `laya` names whichever model the server has configured.
model = "laya"
# How long to wait before falling back to the deterministic path. Keep this
# short: a cold model takes 10-20s to load and blocking an import on that is
# worse than classifying without it.
timeout_ms = 5000
# The posterior at or above which an acceptance is kept. High on purpose:
# §11.14's posture is "reject the obvious junk, hold the rest", so the unusual
# case goes to a person. Lower it only after reading the audit trail.
accept_threshold = 0.90
# Below this the model is not consulted at all — a near-zero posterior on "is
# this a work?" is the deterministic path's own answer.
consult_floor = 0.10
# The API key is NOT set here. Put it in the environment instead:
#   DARKHOLD_DECISIONS_API_KEY=sk-unsloth-...
# A key in this file is a key in a git repository, a backup, and a paste into
# a bug report.
# ---------------------------------------------------------------------------
# The Darkhold sections: governance, policy, tiers and the instance theme.
#
# Every key below has a documented default, and an absent section is the
# default — so this file documents the defaults, it does not have to be
# complete. A section that names one key keeps the documented value for every
# key it omits.
#
# **Precedence: command line → environment (`DARKHOLD_*`) → file → default.**
# **Validation at startup, not at use:** a value that cannot be sane is refused
# when the instance starts, and the refusal names the key.
# ---------------------------------------------------------------------------

# The compute tiers — who gets which algorithm (spec §12.6).
#
# **A tier buys compute, and never rank** (D-10, N-1). Every key here decides
# how much work the instance does for a reader, and none of them decides where
# a reader's work appears in a list.
#
# The three T2 gates are evaluated in a fixed order — supporter, then trust,
# then resonance — and exactly one wins, because three overlapping "or"
# conditions produce an ambiguous tier and an ambiguous explanation.
[tiers]
# T0 is the house theme, and it is always available. The only value is
# "always": T0 is not "no recommendations", it is a real recommendation and it
# is explained.
house = "always"
# T1 (personal, lite) needs a registered account. Lite mode is the reader's own
# profile blended with the house floor: tag overlap and neighbourhood, no
# embeddings and no multi-strategy fusion.
personal_min_trust = 1
# Whether the Supporter tier reaches T2.
full_supporter = true
# The trust level that reaches T2.
full_min_trust = 4
# The resonance that reaches T2. A reader with no evidence has resonance 0
# regardless of agreement, because agreement without evidence is a coincidence.
full_min_resonance = 0.55

# Channel voting — the community's share of a channel's tag weights (spec §12.10,
# §12.12). A channel is a theme (§12.10: "Two kinds, and they are the same
# object"), so this is the specification's `[themes.voting]` table under the
# name the operator actually sees it by.
[channels.voting]
enabled = true
# The trust level a ballot needs.
min_trust_level = 3
# The resonance a ballot needs.
min_resonance = 0.55
# Whether only supporters may vote.
supporter_only = false
# How long a voting period runs.
period_days = 7
# The most a tag's weight may move in one period, as a fraction of the
# remaining distance. A weight that could jump would make last month's
# recommendation unexplainable against this month's weights.
max_shift_per_period = 0.25
# The owner's permanent share of every weight. The owner votes like anyone
# else; the seed floor is the structural advantage, not a second ballot.
seed_floor = 0.2
# The community's convergence rate.
tau = 25

# The Supporter tier — the grant sources and the price (spec §18).
#
# **The grant sources must be more than one.** D-9 makes the instance an
# adult-content host by default, and no mainstream payment processor accepts
# that content — so a payment-only tier is unbuildable on the default instance.
[supporters.grants]
# The operator issues signed codes, grants by account, by invite, or through a
# manual approval queue. The default, and the only one that works with D-9.
self_hosted = true
# A monthly or annual subscription through an operator-chosen processor.
payment_processor = false
# A peer instance vouches for a reader's entitlement.
federated = false
# The operator sells codes by hand, by transfer, by crypto, or through a page
# of their own.
code_purchase = false

[supporters.price]
# In the smallest unit of the currency: 500 is 5.00.
monthly = 500
annual = 5000
currency = "EUR"

# Consent — the gate that creates a guest identity (spec §14.3).
#
# Until consent is accepted the site is anonymous read-only, and the refusal is
# the API's, not the toast's.
[consent]
# Whether a guest must accept consent before the instance will create one.
required_for_guest = true
# The version stamped on the record. Bumping it re-asks.
version = 1
# The age gate's mode. "required" on an adult-content instance (D-9).
age_gate = "required"
# Whether a version bump re-asks every reader.
reask_on_version_change = true

[consent.categories]
# `essential` is always on.
essential = true
# `analytics` and `personalisation` are opt-in.
analytics = false
personalisation = false

# Guests — real identities with a door that closes on MAU (spec §14.1).
#
# A guest is a row in `accounts` with an empty credential, not a cookie-only
# shadow. A guest's rate limits are a logged-in new user's: never higher,
# never lower.
[guest]
# Whether guest identities may be created at all.
enabled = true
# Monthly active accounts above which new guests are refused. 0 disables guest
# access entirely.
mau_limit = 500
# The window MAU is counted over, in days.
mau_window_days = 30
# What happens at the cap: "close" refuses new guests, "throttle" slows them.
on_cap = "close"
# How many days a refused guest is refused for.
grace_days = 7
# The trust level a guest holds. Never a moderation level.
parity_level = 1

# Merges — the identity model's merge policy (spec §9.5).
[merge]
# Whether merges may be proposed at all.
enabled = true
# Whether a merge grants trust. False by default: a merge is a statement about
# identity, not a grant of standing.
grants_trust = false
# Whether a merge grants tenure.
grants_tenure = true
# Whether the parties are notified of a merge.
notify = true
# What happens to the merged-away record: "anonymize" keeps it, scrubbed.
tombstone = "anonymize"

# Trust — the ladder, and the elasticity beneath it (spec §14.4).
[trust]
# The fewest holders an elastic level needs before it holds.
elastic_min_holders = 1
# The floor an elastic level decays to.
floor_level = 2
# How long an elastic level takes to decay, in days.
elastic_decay_days = 30
# The level a guest holds.
guest_level = 1
# Whether a guest may earn trust. FALSE, ALWAYS — a guest can never extend
# trust, so setting this to true is refused at startup rather than ignored.
guest_earns = false

# Self-governance — the jury and the appeals (spec §14.5).
[governance]
# Whether the instance's self-governance surfaces are live.
enabled = true
# How many people sit on a jury.
jury_size = 5
# The trust level a juror needs.
jury_min_level = 3
# The fewest holders an elastic juror pool needs.
jury_elastic_min = 3
# Whether an appeal is heard by a fresh jury.
appeal_fresh_jury = true
# Whether administrators may act outside the jury.
admin_emergency_only = true
# How many days before a ban is reviewed.
ban_review_days = 90

# The mood gate — who may create a mood, and how many (spec §12.3).
#
# A mood is a TRUST gate, not a payment gate (spec §18), so it is configured
# separately from the Supporter tier even when both are enabled.
[discovery.moods]
enabled = true
# The trust level a reader needs to create one.
min_trust_level = 3
# Whether only supporters may create one.
supporter_only = false
# The most moods one account may hold.
max_moods_per_account = 12

# The instance theme — the published editorial position (spec §12.1).
[theme]
# Whether the instance theme is published. It defaults to false, because an
# instance with no theme seed has no theme to publish, and an empty published
# theme is a position nobody took.
published = false
# How strongly a work carrying a tag the theme is AGAINST is demoted. It is a
# penalty and never a negative weight in the vector, because §12.12.3 asserts a
# share against the normalised effective weight, and a negative weight makes
# that share undefined.
opposition_weight = 0.35

# The three signal weights the house taste is blended from (spec §12.1, D-11).
#
# **The ordering is the design and the numbers are configuration.** Works
# indicate a theme better than authors, and authors better than tags: a work is
# a complete statement of what an instance is about, an author is a statement
# about a body of work, and a tag is a statement about a category, which is the
# most widely shared thing in a catalogue.
#
# The order is NOT a preference. A file that inverts it is refused at startup.
[theme.signal_weights]
works = 0.60
authors = 0.25
tags = 0.15

# The taste engine's deployment shape (spec §8.2).
[taste]
# "embedded" runs the taste engine inside the archive, which is right for a
# small instance and leaves one binary to deploy. "service" runs it as its own
# process, which is right for a large one, because the graph's RSS is then the
# service's problem and the archive's RSS stays flat.
#
# In one process the peak RSS is the SUM of the phases, not the maximum, and
# the sum does not fit on the target hardware. That measurement is why this is a
# setting rather than a decision.
mode = "embedded"
