# Environment variables accepted by Lorehaven.
#
# These mirror `lorehaven.toml` and win over it. Command-line arguments win over
# both. Nothing here is required: every value has a documented default.
#
# Copy to `.env` for local use — but note the server reads the process
# environment, not this file, so export it first:
#   set -a && . ./.env && set +a && cargo run -- serve

# --- environment ------------------------------------------------------------
LOREHAVEN_ENV=development

# --- site -------------------------------------------------------------------
LOREHAVEN_BASE_URL=http://localhost:8080

# --- server -----------------------------------------------------------------
LOREHAVEN_BIND=127.0.0.1
LOREHAVEN_PORT=8080

# --- database ---------------------------------------------------------------
# SQLite needs no server:
LOREHAVEN_DATABASE_URL=sqlite://./data/lorehaven.sqlite?mode=rwc
# PostgreSQL:
# LOREHAVEN_DATABASE_URL=postgres://lorehaven:secret@localhost/lorehaven

# --- storage ----------------------------------------------------------------
LOREHAVEN_STORAGE_ROOT=./data

# --- logging ----------------------------------------------------------------
LOREHAVEN_LOG=info,lorehaven_app=debug,lorehaven_db=debug
# pretty | json
LOREHAVEN_LOG_FORMAT=pretty

# --- configuration file -----------------------------------------------------
# LOREHAVEN_CONFIG=./lorehaven.toml

# Production deployments must also set, at minimum:
#   LOREHAVEN_ENV=production
#   LOREHAVEN_BASE_URL=https://your.domain
#   LOREHAVEN_STORAGE_ROOT=/var/lib/lorehaven
# and leave [security] cookie_secure = true. `lorehaven doctor` reports any
# setting that would make a production instance unsafe.
