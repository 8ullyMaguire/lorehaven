# Environment variables accepted by Darkhold.
#
# These mirror `darkhold.toml` and win over it. Command-line arguments win over
# both. Nothing here is required: every value has a documented default.
#
# Copy to `.env` for local use — but note the server reads the process
# environment, not this file, so export it first:
#   set -a && . ./.env && set +a && cargo run -- serve

# --- environment ------------------------------------------------------------
DARKHOLD_ENV=development

# --- site -------------------------------------------------------------------
DARKHOLD_BASE_URL=http://localhost:8080

# --- server -----------------------------------------------------------------
DARKHOLD_BIND=127.0.0.1
DARKHOLD_PORT=8080

# --- database ---------------------------------------------------------------
# SQLite needs no server:
DARKHOLD_DATABASE_URL=sqlite://./data/darkhold.sqlite?mode=rwc
# PostgreSQL:
# DARKHOLD_DATABASE_URL=postgres://darkhold:secret@localhost/darkhold

# --- storage ----------------------------------------------------------------
DARKHOLD_STORAGE_ROOT=./data

# --- logging ----------------------------------------------------------------
DARKHOLD_LOG=info,darkhold_app=debug,darkhold_db=debug
# pretty | json
DARKHOLD_LOG_FORMAT=pretty

# --- configuration file -----------------------------------------------------
# DARKHOLD_CONFIG=./darkhold.toml

# Production deployments must also set, at minimum:
#   DARKHOLD_ENV=production
#   DARKHOLD_BASE_URL=https://your.domain
#   DARKHOLD_STORAGE_ROOT=/var/lib/darkhold
# and leave [security] cookie_secure = true. `darkhold doctor` reports any
# setting that would make a production instance unsafe.
